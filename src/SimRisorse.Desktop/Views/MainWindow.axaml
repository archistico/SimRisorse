<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimRisorse.Desktop.Presentation"
        xmlns:pixel="using:SimRisorse.Desktop.Presentation"
        x:Class="SimRisorse.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="SimRisorse" Width="1240" Height="850" MinWidth="1040" MinHeight="740"
        Background="#EAE8DC" Foreground="#263349" FontFamily="{DynamicResource ContentControlThemeFontFamily}">
  <Window.Resources>
    <DataTemplate x:Key="ResourceDetailTemplate" x:DataType="vm:ResourceDetailLine">
      <Grid ColumnDefinitions="14,*" ColumnSpacing="7" Margin="0,2">
        <pixel:PixelGlyph Key="{Binding ResourceId}" Width="14" Height="14" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Grid ColumnDefinitions="240,*">
    <Border x:Name="SidebarPanel" Background="#263349" Padding="16,14" BorderBrush="#F2D49B" BorderThickness="0,0,2,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="SIMRISORSE" FontSize="20" FontWeight="Bold" Foreground="#F2D49B" />
          <TextBlock Text="▣ COLONIA · 8 BIT" Foreground="#66BED0" FontSize="11" FontWeight="Bold" />
          <TextBlock Text="La tua colonia, una scelta alla volta." Foreground="#D0D7D4" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
        </StackPanel>
        <ListBox x:Name="NavigationMenu" Grid.Row="1" Classes="navigation" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                 SelectedIndex="{Binding SelectedIndex, ElementName=Sections, Mode=TwoWay}">
          <ListBoxItem x:Name="BuildingsNavigation" Content="Edifici" />
          <ListBoxItem x:Name="ResourcesNavigation" Content="Risorse" />
        </ListBox>
        <ScrollViewer Grid.Row="2" Margin="0,12,0,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Background="#303B50" BorderBrush="#66BED0" BorderThickness="1" CornerRadius="0" Padding="10" VerticalAlignment="Top"><StackPanel Spacing="7">
          <TextBlock Text="ISOLA INIZIALE" FontSize="10" Foreground="#BCD6C9" />
          <TextBlock Text="{Binding ScenarioName}" Foreground="White" TextWrapping="Wrap" FontWeight="SemiBold" />
          <StackPanel IsVisible="{Binding HasPopulationGrowth}" Spacing="6">
            <TextBlock Text="CRESCITA" FontSize="10" Foreground="#BCD6C9" />
            <TextBlock x:Name="GrowthStatusText" Text="{Binding GrowthStatus}" Foreground="White" TextWrapping="Wrap" FontSize="12" />
            <ProgressBar x:Name="GrowthProgressBar" Value="{Binding GrowthPercent}" Maximum="100" MinWidth="0" Height="4" Foreground="#E2D1A2" />
            <TextBlock Text="FABBISOGNO" FontSize="10" Foreground="#BCD6C9" />
            <TextBlock Text="{Binding FoodRequirement}" Foreground="#BCD6C9" TextWrapping="Wrap" FontSize="11" />
            <TextBlock x:Name="BreadRequirementText" Text="{Binding BreadRequirement}" IsVisible="{Binding HasAdvancedHousingRules}" Foreground="#BCD6C9" TextWrapping="Wrap" FontSize="11" />
            <TextBlock x:Name="BreadSupplyStatusText" Text="{Binding BreadSupplyStatus}" IsVisible="{Binding ShowBreadSupplyStatus}" Foreground="#E2D1A2" TextWrapping="Wrap" FontSize="11" />
            <TextBlock x:Name="GrowthPauseNote" Text="In pausa il progresso resta fermo." Foreground="#BCD6C9" TextWrapping="Wrap" FontSize="11" />
          </StackPanel>
        </StackPanel></Border>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="6">
          <TextBlock Text="Una filiera in equilibrio" FontWeight="SemiBold" Foreground="#E2D1A2" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="18,12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBlock Text="La tua colonia" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Grid.Column="1" Background="#F1E6C9" BorderBrush="#263349" BorderThickness="1" CornerRadius="0" Padding="12,7"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding PlayState}" FontSize="10" FontWeight="Bold" Foreground="#466253" VerticalAlignment="Center" />
          <TextBlock x:Name="ClockText" Text="{Binding Clock}" FontSize="20" FontWeight="SemiBold" />
        </StackPanel></Border>
        <Button x:Name="PauseButton" Grid.Column="2" Classes="primary" Content="{Binding PauseAction}" Command="{Binding TogglePauseCommand}" VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="160,*" ColumnSpacing="8">
        <Border x:Name="PopulationCard" Background="#FFFDF4" BorderBrush="#303B50" BorderThickness="1" Padding="10,7" ToolTip.Tip="{Binding Population}">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <pixel:PixelGlyph x:Name="PopulationGlyph" Key="population" Width="16" Height="16" />
              <TextBlock Text="ABITANTI" Classes="label" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="PopulationCountText" Grid.Row="1" Text="{Binding PopulationCount}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="AvailableWorkersText" Grid.Row="2" Text="{Binding AvailableWorkersText}" Classes="label" />
            <ProgressBar Grid.Row="3" Value="{Binding HousingFillPercent}" IsVisible="{Binding HasPopulationGrowth}" Maximum="100" MinWidth="0" Height="3" Margin="0,3,0,0" Foreground="#478B71" />
          </Grid>
        </Border>
            <ItemsControl x:Name="ResourceHighlights" Grid.Column="1" ItemsSource="{Binding ResourceHighlights}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ResourceRow">
                <Border Background="#FFFDF4" BorderBrush="#303B50" BorderThickness="1" CornerRadius="0" Padding="10,7" Margin="0,0,8,0"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
                  <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6"><pixel:PixelGlyph Key="{Binding Id}" Width="16" Height="16" /><TextBlock Text="{Binding Name}" Classes="label" VerticalAlignment="Center" /></StackPanel>
                  <TextBlock Grid.Row="1" Text="{Binding Quantity}" FontSize="21" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NetRate}" FontSize="12" Foreground="{Binding NetForeground}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Stock}" Classes="label" />
                  <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Value="{Binding FillPercent}" Maximum="100" MinWidth="0" Height="3" Margin="0,3,0,0" Foreground="#478B71" />
                </Grid></Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
      </Grid>
      <TabControl x:Name="Sections" Grid.Row="2" Background="Transparent" SelectedIndex="0">
        <TabControl.Template>
          <ControlTemplate>
            <Grid RowDefinitions="0,*">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" IsHitTestVisible="False" ClipToBounds="True" />
              <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
          </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="Edifici">
            <Grid x:Name="BuildingWorkspace" ColumnDefinitions="*,310" ColumnSpacing="12">
              <Border Background="#FFFDF4" BorderBrush="#303B50" BorderThickness="1" CornerRadius="0" Padding="8,10">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <Grid ColumnDefinitions="*,62,82" Margin="13,0,8,0"><TextBlock Text="STRUTTURA" Classes="label" /><TextBlock Grid.Column="1" Text="EDIFICI" Classes="label" /><TextBlock Grid.Column="2" Text="PERSONALE" Classes="label" /></Grid>
                  <ListBox x:Name="BuildingsList" Grid.Row="1" ItemsSource="{Binding Buildings}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:BuildingRow">
                      <Grid ColumnDefinitions="34,*,55,76" RowDefinitions="Auto,Auto" Margin="3,6" ColumnSpacing="6" RowSpacing="4">
                        <Border Grid.RowSpan="2" Background="#E8E4D6" BorderBrush="#697787" BorderThickness="1" Width="32" Height="34" CornerRadius="0" VerticalAlignment="Top"><pixel:PixelGlyph Key="{Binding Id}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Staff}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Status}" FontSize="12" Foreground="#66766E" />
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#DFE7E3" BorderBrush="#303B50" BorderThickness="1" CornerRadius="0" Padding="14,10">
                <Grid RowDefinitions="*,Auto" RowSpacing="6">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="6">
                    <TextBlock Text="{Binding Selected.Name}" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="BuildingDescriptionText" Text="{Binding Selected.Description}" TextWrapping="Wrap" FontSize="12" Foreground="#53685C" LineHeight="17" />
                    <TextBlock x:Name="ConstructionCostText" Text="{Binding ConstructionCostHeading}" Classes="label" FontSize="11" Margin="0,4,0,0" />
                    <ItemsControl x:Name="ConstructionCostList" ItemsSource="{Binding SelectedCostLines}" ItemTemplate="{StaticResource ResourceDetailTemplate}" />
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                      <TextBlock Text="{Binding Selected.OutputHeading}" Classes="label" FontSize="11" />
                      <ItemsControl x:Name="ProductionOutputList" ItemsSource="{Binding Selected.OutputLines}" IsVisible="{Binding Selected.IsProducer}" ItemTemplate="{StaticResource ResourceDetailTemplate}" />
                      <TextBlock Text="{Binding Selected.Output}" IsVisible="{Binding !Selected.IsProducer}" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock Text="{Binding Selected.Consumption}" IsVisible="{Binding Selected.HasInputs}" TextWrapping="Wrap" Classes="label" />
                    </StackPanel>
                  </StackPanel></ScrollViewer>
                  <StackPanel Grid.Row="1" Spacing="6">
                    <Border x:Name="BuildingDiagnosisPanel" Background="#F5EADB" BorderBrush="#9A6947" BorderThickness="1" CornerRadius="0" Padding="9,7" IsVisible="{Binding Selected.HasDiagnosis}">
                      <TextBlock x:Name="ProductionDiagnosisText" Text="{Binding Selected.Diagnosis}" TextWrapping="Wrap" FontSize="12" Foreground="#735A37" />
                    </Border>
                    <Border Background="#CBD7C9" Height="1" Margin="0,1" />
                    <Grid ColumnDefinitions="*,90"><TextBlock Text="Quantità per ordine" VerticalAlignment="Center" Classes="label" /><ComboBox x:Name="BatchSelector" Grid.Column="1" ItemsSource="{Binding BatchSizes}" SelectedItem="{Binding BatchSize, Mode=TwoWay}" HorizontalAlignment="Stretch" /></Grid>
                    <Button x:Name="BuildButton" Classes="primary build" Content="{Binding BuildLabel}" Command="{Binding ConstructCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7"><Button x:Name="ReleaseButton" Content="− Lavoratori" Command="{Binding ReleaseCommand}" Padding="7,7" FontSize="12" HorizontalAlignment="Stretch" /><Button x:Name="AssignButton" Grid.Column="1" Content="+ Lavoratori" Command="{Binding AssignCommand}" Padding="7,7" FontSize="12" HorizontalAlignment="Stretch" /></Grid>
                    <TextBlock Text="{Binding Selected.Activity}" TextWrapping="Wrap" Classes="label" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
        </TabItem>
        <TabItem x:Name="ResourcesTab" Header="Risorse">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <TextBlock Text="Scorte e flussi del prossimo secondo. In pausa le quantità restano ferme." FontSize="12" TextWrapping="Wrap" Foreground="#66766E" />
            <Border Grid.Row="1" Background="#FFFDF4" BorderBrush="#303B50" BorderThickness="1" CornerRadius="0" Padding="12">
              <Grid RowDefinitions="Auto,*" RowSpacing="13">
                <Grid ColumnDefinitions="*,120,100,115,115,90"><TextBlock Text="Risorsa" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Quantità" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="Capacità" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="Produzione /s" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="Consumo /s" FontWeight="SemiBold" /><TextBlock Grid.Column="5" Text="Saldo /s" FontWeight="SemiBold" /></Grid>
                <ScrollViewer x:Name="ResourcesScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="ResourcesTable" ItemsSource="{Binding Resources}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ResourceRow">
                      <Grid ColumnDefinitions="*,120,100,115,115,90" Margin="0,8">
                        <StackPanel Orientation="Horizontal" Spacing="8"><pixel:PixelGlyph Key="{Binding Id}" Width="20" Height="20" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Quantity}" /><TextBlock Grid.Column="2" Text="{Binding Capacity}" /><TextBlock Grid.Column="3" Text="{Binding Production}" /><TextBlock Grid.Column="4" Text="{Binding Consumption}" /><TextBlock Grid.Column="5" Text="{Binding NetRate}" FontWeight="SemiBold" Foreground="{Binding NetForeground}" />
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="Il saldo considera lavoratori, fabbisogno degli abitanti, input disponibili, spazio e priorità delle filiere." Classes="label" TextWrapping="Wrap" />
          </Grid>
        </TabItem>
      </TabControl>
      <StackPanel Grid.Row="3" Spacing="6">
        <Border Background="#F1E6C9" BorderBrush="#9A6947" BorderThickness="1" CornerRadius="0" Padding="10,6"><TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#625A3D" /></Border>
        <Border IsVisible="{Binding IsNewGameConfirmationVisible}" Background="#E6EBE3" BorderBrush="#303B50" BorderThickness="1" CornerRadius="0" Padding="10"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Avviare una nuova partita? La sessione attuale sarà sostituita." TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
          <Button x:Name="ConfirmNewGameButton" Grid.Column="1" Content="Avvia nuova" Command="{Binding ConfirmNewGameCommand}" /><Button Grid.Column="2" Content="Annulla" Command="{Binding CancelNewGameCommand}" />
        </Grid></Border>
        <Button x:Name="DiscardCloseButton" IsVisible="{Binding IsCloseFailureVisible}" Content="Esci senza salvare" Click="DiscardCloseClick" HorizontalAlignment="Right" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9">
          <TextBlock Text="{Binding BusyState}" Classes="label" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="NewGameButton" Grid.Column="1" Content="Nuova partita" Command="{Binding NewGameCommand}" />
          <Button x:Name="LoadButton" Grid.Column="2" Content="Carica" Command="{Binding LoadCommand}" />
          <Button x:Name="SaveButton" Grid.Column="3" Content="Salva" Command="{Binding SaveCommand}" />
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
