<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimRisorse.Desktop.Presentation"
        x:Class="SimRisorse.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="SimRisorse" Width="1240" Height="850" MinWidth="1040" MinHeight="740"
        Background="#F4F5F0" Foreground="#1E332B" FontFamily="Segoe UI">
  <Grid ColumnDefinitions="185,*">
    <Border Background="#173D32" Padding="22,30">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="8">
          <TextBlock Text="SIMRISORSE" FontSize="20" FontWeight="Bold" Foreground="#F4F1E5" />
          <TextBlock Text="La tua colonia, una scelta alla volta." Foreground="#AFCCC0" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
        </StackPanel>
        <Border Grid.Row="1" Background="#2A5345" CornerRadius="7" Padding="12" Margin="0,35,0,0"><StackPanel Spacing="10">
          <TextBlock Text="ISOLA INIZIALE" FontSize="10" Foreground="#BCD6C9" />
          <TextBlock Text="Economia e persone" Foreground="White" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel></Border>
        <StackPanel Grid.Row="3" Spacing="10">
          <TextBlock Text="Una filiera in equilibrio" FontWeight="SemiBold" Foreground="#E2D1A2" TextWrapping="Wrap" />
          <TextBlock Text="Edifici, lavoratori e materiali devono crescere insieme. Cerca il prossimo collo di bottiglia." Foreground="#AFCCC0" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="27,24" RowDefinitions="Auto,*,Auto" RowSpacing="18">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
        <StackPanel Spacing="5"><TextBlock Text="La tua colonia" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding Population}" Foreground="#66766E" /></StackPanel>
        <Border Grid.Column="1" Background="#E5EBE2" CornerRadius="8" Padding="18,9"><StackPanel Spacing="3">
          <TextBlock Text="{Binding PlayState}" FontSize="10" FontWeight="Bold" Foreground="#466253" />
          <TextBlock x:Name="ClockText" Text="{Binding Clock}" FontSize="23" FontWeight="SemiBold" />
        </StackPanel></Border>
        <Button x:Name="PauseButton" Grid.Column="2" Classes="primary" Content="{Binding PauseAction}" Command="{Binding TogglePauseCommand}" VerticalAlignment="Center" />
      </Grid>
      <TabControl x:Name="Sections" Grid.Row="1" Background="Transparent">
        <TabItem Header="Edifici">
          <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="0,14,0,0">
            <ItemsControl ItemsSource="{Binding Resources}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ResourceRow">
                <Border Background="White" CornerRadius="9" Padding="16,12" Margin="0,0,10,0"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                  <TextBlock Text="{Binding Name}" Classes="label" /><TextBlock Grid.Column="1" Text="Saldo previsto" Classes="label" FontSize="10" HorizontalAlignment="Right" />
                  <TextBlock Grid.Row="1" Text="{Binding Quantity}" FontSize="27" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NetRate}" Foreground="#176858" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Stock}" Classes="label" />
                  <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Value="{Binding FillPercent}" Maximum="100" Height="3" Margin="0,3,0,0" Foreground="#478B71" />
                </Grid></Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Grid.Row="1" ColumnDefinitions="*,310" ColumnSpacing="16">
              <Border Background="White" CornerRadius="9" Padding="8,16">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                  <Grid ColumnDefinitions="*,62,82" Margin="13,0,8,0"><TextBlock Text="STRUTTURA" Classes="label" /><TextBlock Grid.Column="1" Text="EDIFICI" Classes="label" /><TextBlock Grid.Column="2" Text="PERSONALE" Classes="label" /></Grid>
                  <ListBox x:Name="BuildingsList" Grid.Row="1" ItemsSource="{Binding Buildings}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:BuildingRow">
                      <Grid ColumnDefinitions="34,*,55,76" RowDefinitions="Auto,Auto" Margin="3,12" ColumnSpacing="6" RowSpacing="8">
                        <Border Grid.RowSpan="2" Background="#E6EBE3" Width="32" Height="36" CornerRadius="5" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#176858" /></Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Staff}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Status}" FontSize="12" Foreground="#66766E" />
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#E8EEE6" CornerRadius="9" Padding="20,18">
                <Grid RowDefinitions="*,Auto" RowSpacing="10">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10">
                    <TextBlock Text="DETTAGLIO STRUTTURA" Classes="label" />
                    <TextBlock Text="{Binding Selected.Name}" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" FontSize="12" Foreground="#53685C" LineHeight="19" />
                    <TextBlock Text="{Binding Selected.Recipe}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="Per lavoratore, ogni secondo di gioco" Classes="label" TextWrapping="Wrap" />
                  </StackPanel></ScrollViewer>
                  <StackPanel Grid.Row="1" Spacing="8">
                    <Border Background="#CBD7C9" Height="1" Margin="0,2" />
                    <Grid ColumnDefinitions="*,90"><TextBlock Text="Quantità per ordine" VerticalAlignment="Center" Classes="label" /><ComboBox x:Name="BatchSelector" Grid.Column="1" ItemsSource="{Binding BatchSizes}" SelectedItem="{Binding BatchSize, Mode=TwoWay}" HorizontalAlignment="Stretch" /></Grid>
                    <TextBlock Text="{Binding SelectedCost}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Button x:Name="BuildButton" Classes="primary" Content="{Binding BuildLabel}" Command="{Binding ConstructCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="7"><Button x:Name="ReleaseButton" Content="− Lavoratori" Command="{Binding ReleaseCommand}" Padding="7,9" FontSize="12" HorizontalAlignment="Stretch" /><Button x:Name="AssignButton" Grid.Column="1" Content="+ Lavoratori" Command="{Binding AssignCommand}" Padding="7,9" FontSize="12" HorizontalAlignment="Stretch" /></Grid>
                    <TextBlock Text="{Binding Selected.Activity}" TextWrapping="Wrap" Classes="label" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem x:Name="ResourcesTab" Header="Risorse">
          <StackPanel Spacing="18" Margin="0,20,0,0">
            <TextBlock Text="Scorte e flussi previsti" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Produzione e consumo previsti per il prossimo secondo di gioco. Durante la pausa le scorte restano ferme." TextWrapping="Wrap" Foreground="#66766E" />
            <Border Background="White" CornerRadius="9" Padding="18">
              <Grid RowDefinitions="Auto,*" RowSpacing="13">
                <Grid ColumnDefinitions="*,130,110,120,120,100"><TextBlock Text="Risorsa" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Quantità" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="Capacità" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="Produzione /s" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="Consumo /s" FontWeight="SemiBold" /><TextBlock Grid.Column="5" Text="Saldo /s" FontWeight="SemiBold" /></Grid>
                <ItemsControl x:Name="ResourcesTable" Grid.Row="1" ItemsSource="{Binding Resources}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ResourceRow">
                    <Grid ColumnDefinitions="*,130,110,120,120,100" Margin="0,13">
                      <TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Quantity}" /><TextBlock Grid.Column="2" Text="{Binding Capacity}" /><TextBlock Grid.Column="3" Text="{Binding Production}" /><TextBlock Grid.Column="4" Text="{Binding Consumption}" /><TextBlock Grid.Column="5" Text="{Binding NetRate}" FontWeight="SemiBold" Foreground="#176858" />
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
            <TextBlock Text="Il saldo considera persone assegnate, input disponibili, spazio e priorità delle filiere." Classes="label" TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>
      </TabControl>
      <StackPanel Grid.Row="2" Spacing="10">
        <Border Background="#E9E5D5" CornerRadius="7" Padding="12,10"><TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#625A3D" /></Border>
        <Border IsVisible="{Binding IsNewGameConfirmationVisible}" Background="#E6EBE3" CornerRadius="7" Padding="10"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="Avviare una nuova partita? La sessione attuale sarà sostituita." TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
          <Button x:Name="ConfirmNewGameButton" Grid.Column="1" Content="Avvia nuova" Command="{Binding ConfirmNewGameCommand}" /><Button Grid.Column="2" Content="Annulla" Command="{Binding CancelNewGameCommand}" />
        </Grid></Border>
        <Button x:Name="DiscardCloseButton" IsVisible="{Binding IsCloseFailureVisible}" Content="Esci senza salvare" Click="DiscardCloseClick" HorizontalAlignment="Right" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9">
          <TextBlock Text="{Binding BusyState}" Classes="label" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="NewGameButton" Grid.Column="1" Content="Nuova partita" Command="{Binding NewGameCommand}" />
          <Button x:Name="LoadButton" Grid.Column="2" Content="Carica" Command="{Binding LoadCommand}" />
          <Button x:Name="SaveButton" Grid.Column="3" Content="Salva" Command="{Binding SaveCommand}" />
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
