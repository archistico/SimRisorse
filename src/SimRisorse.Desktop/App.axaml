<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimRisorse.Desktop.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="0" /><Setter Property="Padding" Value="12,8" />
      <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#176858" /><Setter Property="Foreground" Value="White" /></Style>
    <!-- Lo spessore del bordo resta identico in tutti gli stati: niente salti di layout in hover. -->
    <Style Selector="Button.primary.build"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="#176858" /></Style>
    <Style Selector="Button.primary.build:pointerover">
      <Setter Property="Background" Value="#259D80" /><Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#145A48" />
    </Style>
    <Style Selector="Button.primary.build:pressed">
      <Setter Property="Background" Value="#105443" /><Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary.build:disabled">
      <Setter Property="Background" Value="#B8C2BC" /><Setter Property="Foreground" Value="#5D6C64" />
      <Setter Property="BorderBrush" Value="#B8C2BC" />
    </Style>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="#66766E" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#EFE6CF" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#E6D5AC" /></Style>
  </Application.Styles>
</Application>
